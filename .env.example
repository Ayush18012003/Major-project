# Depression Detection AI - Environment Configuration Example
# Copy this file to .env and fill in your values

# Model Configuration
MODEL_PATH=depression_detection_model.keras
TOKENIZER_PATH=tokenizer.pkl
MAX_SEQUENCE_LENGTH=300

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=false
STREAMLIT_LOGGER_LEVEL=info

# API Configuration (for API deployment)
API_HOST=0.0.0.0
API_PORT=5000
DEBUG_MODE=False

# Database Configuration (for future features)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=depression_detection
# DB_USER=admin
# DB_PASSWORD=password

# External Services
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AZURE_SUBSCRIPTION_ID=your_subscription

# Monitoring & Logging
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
# SENTRY_DSN=your_sentry_dsn

# Security
# SECRET_KEY=your_secret_key
# ALLOWED_HOSTS=localhost,127.0.0.1

# Feature Flags
ENABLE_TEXT_CLEANING_DEMO=true
ENABLE_CONFIDENCE_LEVELS=true
ENABLE_BATCH_PROCESSING=false
ENABLE_API_ENDPOINT=false
